# Copy to .env and adjust. Real environment variables override these values.

# Database file. Relative paths are resolved from the Browser folder.
# If omitted, the first *.sqlite / *.sqlite3 / *.db file in Browser/ or
# Browser/data/ is used.
DB_PATH=data/sample.sqlite3

# Password for SQLCipher-encrypted files (as created by Parser/dbcreator.py).
# Leave empty for plain SQLite files. Everything after "=" is used literally,
# including "#"; wrap in quotes only if the password has leading/trailing spaces.
DB_PASSWORD=

# Web server. Keep 127.0.0.1 unless you really want other machines to connect.
HOST=127.0.0.1
PORT=5000

# Set to true to disable add/edit/delete.
READ_ONLY=false
