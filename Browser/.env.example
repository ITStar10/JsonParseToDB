# Copy to .env and adjust. Real environment variables override these values.

# Database file. Relative paths are resolved from the Browser folder.
# If omitted, the first *.sqlite / *.sqlite3 / *.db file in Browser/ or
# Browser/data/ is used.
DB_PATH=data/sample.sqlite3

# Password for SQLCipher-encrypted files (as created by Parser/dbcreator.py).
# Leave empty for plain SQLite files. Everything after "=" is used literally,
# including "#"; wrap in quotes only if the password has leading/trailing spaces.
DB_PASSWORD=

# Web server. Keep 127.0.0.1 unless you really want other machines to connect.
HOST=127.0.0.1
PORT=5000

# Set to true to disable add/edit/delete.
READ_ONLY=false

# ---- Accounts ----------------------------------------------------------
# Users database (accounts, approval status, data access rules).
# Default: instance/users.sqlite3. Kept separate from the data file.
# USERS_DB_PATH=instance/users.sqlite3

# Key that signs session cookies. If empty, a random key is generated once and
# stored in instance/secret_key. Changing it signs everyone out.
# SECRET_KEY=

# Set to true when the site is served over HTTPS, so cookies are only sent
# over encrypted connections.
COOKIE_SECURE=false

# Behind an HTTPS reverse proxy: the public host name(s) users type, comma
# separated (e.g. data.example.com), and TRUST_PROXY=true so the client IP and
# https scheme are taken from the proxy's X-Forwarded-* headers. Only enable
# TRUST_PROXY when a proxy is really in front, otherwise clients can spoof it.
ALLOWED_HOSTS=
TRUST_PROXY=false
